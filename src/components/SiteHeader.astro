---
import CrossMark from "@components/CrossMark.astro";

const navItems = [
  { href: "/", label: "Início" },
  { href: "/ensaios/", label: "Ensaios" },
  { href: "/temas/", label: "Temas" },
  { href: "/biblioteca/", label: "Biblioteca" },
  { href: "/sobre/", label: "Sobre" },
];

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

const now = new Date();
const ptDate = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "long",
}).format(now);
---

<header class="site-header">
  <div class="container--wide site-header__inner">
    <p class="site-header__meta" aria-label="Edição corrente">
      <span class="site-header__meta-line">Caderno brasileiro</span>
      <span class="site-header__meta-sub">{ptDate}</span>
    </p>

    <a class="site-header__brand" href="/" aria-label="Após a Queda — página inicial">
      <CrossMark size={14} class="site-header__brand-mark-cross" />
      <span class="site-header__brand-mark">Após a Queda</span>
      <span class="site-header__brand-sub">Pecado Original, Consciência e Condição Humana</span>
    </a>

    <nav class="site-header__nav" aria-label="Navegação principal">
      {
        navItems.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
