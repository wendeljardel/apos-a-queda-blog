---
interface Props {
  size?: number;
  decorative?: boolean;
  title?: string;
  variant?: "pommee" | "fleury" | "latin";
  class?: string;
}

const {
  size = 18,
  decorative = true,
  title = "Cruz",
  variant = "pommee",
  class: className = "",
} = Astro.props;
---

<svg
  width={size}
  height={size * 1.5}
  viewBox="0 0 32 48"
  xmlns="http://www.w3.org/2000/svg"
  fill="none"
  role={decorative ? "presentation" : "img"}
  aria-hidden={decorative ? "true" : undefined}
  aria-label={decorative ? undefined : title}
  class={className}
>
  {!decorative && <title>{title}</title>}
  {
    variant === "pommee" && (
      <g stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
        <line x1="16" y1="6" x2="16" y2="42" />
        <line x1="4" y1="20" x2="28" y2="20" />
        <circle cx="16" cy="6" r="1.8" fill="currentColor" />
        <circle cx="16" cy="42" r="1.8" fill="currentColor" />
        <circle cx="4" cy="20" r="1.8" fill="currentColor" />
        <circle cx="28" cy="20" r="1.8" fill="currentColor" />
      </g>
    )
  }
  {
    variant === "fleury" && (
      <g
        stroke="currentColor"
        stroke-width="0.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      >
        <line x1="16" y1="9" x2="16" y2="39" />
        <line x1="7" y1="20" x2="25" y2="20" />
        <path d="M16 9 c -2 -3, -4 -3, -4 -5 c 0 -2, 2 -3, 4 -1 c 2 -2, 4 -1, 4 1 c 0 2, -2 2, -4 5 z" />
        <path d="M16 39 c -2 3, -4 3, -4 5 c 0 2, 2 3, 4 1 c 2 2, 4 1, 4 -1 c 0 -2, -2 -2, -4 -5 z" />
        <path d="M7 20 c -3 -2, -3 -4, -5 -4 c -2 0, -3 2, -1 4 c -2 2, -1 4, 1 4 c 2 0, 2 -2, 5 -4 z" />
        <path d="M25 20 c 3 -2, 3 -4, 5 -4 c 2 0, 3 2, 1 4 c 2 2, 1 4, -1 4 c -2 0, -2 -2, -5 -4 z" />
      </g>
    )
  }
  {
    variant === "latin" && (
      <g stroke="currentColor" stroke-width="1.2" stroke-linecap="square">
        <line x1="16" y1="4" x2="16" y2="44" />
        <line x1="6" y1="16" x2="26" y2="16" />
      </g>
    )
  }
</svg>
