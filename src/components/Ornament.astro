---
interface Props {
  variant?: "full" | "compact" | "fleuron" | "cross";
  withRule?: boolean;
}

const { variant = "full", withRule = true } = Astro.props;
const classes = [
  "ornament",
  variant === "compact" && "ornament--compact",
  variant === "fleuron" && "ornament--fleuron",
  variant === "cross" && "ornament--cross",
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes} role="separator" aria-hidden="true">
  {variant === "fleuron" ? null : withRule && <span class="ornament__rule"></span>}

  {
    variant === "fleuron" && (
      <svg
        class="ornament__fleuron"
        viewBox="0 0 180 54"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
      >
        <path
          d="M90 8 V38 M79 19 H101"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
        <path
          d="M90 40 C84 32 73 28 73 19 C73 14 77 11 82 11 C86 11 88 14 90 17 C92 14 94 11 98 11 C103 11 107 14 107 19 C107 28 96 32 90 40Z"
          fill="currentColor"
          opacity="0.2"
          stroke="currentColor"
          stroke-width="1.2"
          stroke-linejoin="round"
        />
        <path
          d="M12 30 C31 18 50 18 70 30 M168 30 C149 18 130 18 110 30"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
        />
        <path
          d="M32 23 C37 15 45 14 50 19 C44 26 38 27 32 23Z M52 27 C59 21 67 22 70 28 C63 34 57 33 52 27Z M148 23 C143 15 135 14 130 19 C136 26 142 27 148 23Z M128 27 C121 21 113 22 110 28 C117 34 123 33 128 27Z"
          fill="currentColor"
          opacity="0.34"
          stroke="currentColor"
          stroke-width="0.8"
        />
        <circle cx="17" cy="30" r="2.4" fill="currentColor" opacity="0.7" />
        <circle cx="163" cy="30" r="2.4" fill="currentColor" opacity="0.7" />
        <path
          d="M72 43 H108"
          stroke="currentColor"
          stroke-width="1.1"
          stroke-linecap="round"
          stroke-dasharray="1 5"
        />
      </svg>
    )
  }

  {
    variant === "cross" && (
      <svg viewBox="0 0 80 28" xmlns="http://www.w3.org/2000/svg" fill="none">
        <g
          stroke="currentColor"
          stroke-width="0.9"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="40" y1="4" x2="40" y2="24" />
          <line x1="32" y1="14" x2="48" y2="14" />
          <circle cx="40" cy="4" r="1.2" fill="currentColor" />
          <circle cx="40" cy="24" r="1.2" fill="currentColor" />
          <circle cx="32" cy="14" r="1.2" fill="currentColor" />
          <circle cx="48" cy="14" r="1.2" fill="currentColor" />
          <line x1="2" y1="14" x2="26" y2="14" />
          <line x1="54" y1="14" x2="78" y2="14" />
          <circle cx="2" cy="14" r="0.9" fill="currentColor" />
          <circle cx="78" cy="14" r="0.9" fill="currentColor" />
        </g>
      </svg>
    )
  }

  {
    variant !== "fleuron" && variant !== "cross" && (
      <svg viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg" fill="none">
        <g
          stroke="currentColor"
          stroke-width="0.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M60 4 C 60 10, 64 13, 70 13 C 64 13, 60 16, 60 22 C 60 16, 56 13, 50 13 C 56 13, 60 10, 60 4 Z" />
          <circle cx="60" cy="13" r="1.2" fill="currentColor" />
          <path d="M44 13 C 36 13, 32 9, 28 13 C 32 17, 36 13, 44 13 Z" />
          <path d="M76 13 C 84 13, 88 9, 92 13 C 88 17, 84 13, 76 13 Z" />
          <path d="M22 13 L 8 13" />
          <path d="M98 13 L 112 13" />
          <circle cx="6" cy="13" r="1.1" fill="currentColor" />
          <circle cx="114" cy="13" r="1.1" fill="currentColor" />
          <path d="M60 22 L 60 28" />
          <path d="M58 28 L 60 30 L 62 28" />
        </g>
      </svg>
    )
  }

  {variant === "fleuron" ? null : withRule && <span class="ornament__rule"></span>}
</div>
