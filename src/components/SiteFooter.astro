---
import CrossMark from "@components/CrossMark.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container--wide site-footer__inner">
    <div>
      <p class="site-footer__brand">Após a Queda</p>
      <p class="site-footer__motto">
        Ensaios sobre pecado original e condição humana: consciência, desejo,
        liberdade, autoridade e vida comum observados à luz da fé católica.
      </p>
    </div>

    <div>
      <h3>Arquivo</h3>
      <ul>
        <li><a href="/ensaios/">Ensaios</a></li>
        <li><a href="/temas/">Temas</a></li>
        <li><a href="/biblioteca/">Biblioteca</a></li>
        <li><a href="/sobre/">Sobre</a></li>
      </ul>
    </div>

    <div>
      <h3>Acompanhar</h3>
      <ul>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/sitemap-index.xml">Sitemap</a></li>
      </ul>
    </div>

    <div class="site-footer__rule">
      <span>© {year} · Após a Queda</span>
      <span class="site-footer__motto-amdg">
        <CrossMark size={12} />
        <em>À maior glória de Deus</em>
      </span>
    </div>
  </div>
</footer>
