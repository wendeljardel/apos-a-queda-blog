---
import BaseLayout from "@layouts/BaseLayout.astro";
import Ornament from "@components/Ornament.astro";
import { formatPubDate, pubDateToDatetime } from "@utils/pubDate";

interface Props {
  title: string;
  description: string;
  sequence: number;
  pubDate: Date;
  categories: string[];
  readingTime: string;
  heroImage?: string;
  heroImageAlt?: string;
}

const {
  title,
  description,
  sequence,
  pubDate,
  categories,
  readingTime,
  heroImage,
  heroImageAlt,
} = Astro.props;

const formattedDate = formatPubDate(pubDate);

const toRoman = (num: number): string => {
  const map: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
    [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let n = num;
  let result = "";
  for (const [value, symbol] of map) {
    while (n >= value) {
      result += symbol;
      n -= value;
    }
  }
  return result;
};
---

<BaseLayout title={title} description={description} ogImage={heroImage}>
  <article class="essay">
    <header class="essay__header">
      <p class="essay__kicker">Ensaio {toRoman(sequence)}</p>
      <h1 class="essay__title">{title}</h1>
      <p class="essay__lede">{description}</p>
      <div class="essay__meta">
        <time datetime={pubDateToDatetime(pubDate)}>{formattedDate}</time>
        <span>{readingTime} de leitura</span>
      </div>
      {
        categories.length > 0 && (
          <ul class="tag-list" aria-label="Categorias">
            {categories.map((category) => <li>{category}</li>)}
          </ul>
        )
      }
    </header>

    {
      heroImage && (
        <figure class="essay__hero">
          <img src={heroImage} alt={heroImageAlt ?? title} loading="eager" />
        </figure>
      )
    }

    <Ornament variant="compact" />

    <div class="prose">
      <slot />
    </div>

    <Ornament variant="cross" />

    <footer class="essay__footer">
      <p><em>Após a Queda · caderno católico de ensaios em construção</em></p>
    </footer>
  </article>
</BaseLayout>
