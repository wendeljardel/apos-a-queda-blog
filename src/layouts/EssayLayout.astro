---
import BaseLayout from "@layouts/BaseLayout.astro";
import Ornament from "@components/Ornament.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  categories: string[];
  readingTime: string;
  heroImage?: string;
  heroImageAlt?: string;
  heroImageCredit?: string;
}

const {
  title,
  description,
  pubDate,
  categories,
  readingTime,
  heroImage,
  heroImageAlt,
  heroImageCredit,
} = Astro.props;

const formattedDate = new Intl.DateTimeFormat("pt-BR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
}).format(pubDate);
---

<BaseLayout title={title} description={description} ogImage={heroImage}>
  <article class="essay">
    <header class="essay__header">
      <p class="essay__kicker">Ensaio</p>
      <h1 class="essay__title">{title}</h1>
      <p class="essay__lede">{description}</p>
      <div class="essay__meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>{readingTime} de leitura</span>
      </div>
      {
        categories.length > 0 && (
          <ul class="tag-list" aria-label="Categorias">
            {categories.map((category) => <li>{category}</li>)}
          </ul>
        )
      }
    </header>

    {
      heroImage && (
        <figure class="essay__hero">
          <img src={heroImage} alt={heroImageAlt ?? title} loading="eager" />
          {heroImageCredit && <figcaption>{heroImageCredit}</figcaption>}
        </figure>
      )
    }

    <Ornament variant="compact" />

    <div class="prose">
      <slot />
    </div>

    <Ornament variant="cross" />

    <footer class="essay__footer">
      <p><em>Após a Queda · caderno católico de ensaios em construção</em></p>
    </footer>
  </article>
</BaseLayout>
