---
import { getCollection } from "astro:content";
import EssayList from "@components/EssayList.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const essays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Ensaios"
  description="Lista cronológica dos ensaios publicados em Após a Queda."
>
  <section class="page-intro">
    <p class="eyebrow">Arquivo</p>
    <h1>Ensaios</h1>
    <p>Textos longos para leitura lenta, releitura e investigação continuada.</p>
  </section>

  <EssayList essays={essays} />
</BaseLayout>
