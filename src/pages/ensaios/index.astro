---
import { getCollection } from "astro:content";
import EssayList from "@components/EssayList.astro";
import Ornament from "@components/Ornament.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const essays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sequence - b.data.sequence);
---

<BaseLayout
  title="Ensaios"
  description="Ensaios publicados em Após a Queda."
>
  <header class="page-intro">
    <p class="essay__kicker">Arquivo</p>
    <h1 class="page-intro__title">Ensaios</h1>
    <p class="page-intro__sub">
      Os textos publicados até aqui, na ordem em que foram escritos.
    </p>
  </header>

  <Ornament />

  <EssayList essays={essays} />
</BaseLayout>
