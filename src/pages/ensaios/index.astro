---
import { getCollection } from "astro:content";
import EssayList from "@components/EssayList.astro";
import Ornament from "@components/Ornament.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const essays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Ensaios"
  description="Lista cronológica dos ensaios publicados em Após a Queda."
>
  <header class="page-intro">
    <p class="essay__kicker">Arquivo cronológico</p>
    <h1 class="page-intro__title">Ensaios</h1>
    <p class="page-intro__sub">
      Textos longos, abertos e em desenvolvimento — para leitura lenta, releitura e ruminação.
    </p>
  </header>

  <Ornament />

  <EssayList essays={essays} />
</BaseLayout>
