---
import { getCollection } from "astro:content";
import EssayList from "@components/EssayList.astro";
import Ornament from "@components/Ornament.astro";
import CrossMark from "@components/CrossMark.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatPubDate, pubDateToDatetime } from "@utils/pubDate";

const allEssays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sequence - b.data.sequence);

const featured = allEssays[0];
const archive = allEssays.slice(1);

const featuredDate = featured ? formatPubDate(featured.data.pubDate) : "";

const year = new Date().getFullYear();

const toRoman = (num: number): string => {
  const map: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
    [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let n = num;
  let result = "";
  for (const [value, symbol] of map) {
    while (n >= value) {
      result += symbol;
      n -= value;
    }
  }
  return result;
};
---

<BaseLayout>
  <section class="masthead" aria-label="Edição corrente">
    <p class="masthead__line">
      Caderno de ensaios · {year}
      <span class="masthead__sep">·</span>
      Edição inaugural
    </p>
    <div class="masthead__rule" aria-hidden="true">
      <span></span>
      <CrossMark size={11} />
      <span></span>
    </div>
  </section>

  <section class="epigraph" aria-label="Epígrafe">
    <p class="epigraph__text">
      Antes de escolher o bem ou o mal, já existe no homem uma inclinação.
    </p>
    <p class="epigraph__cite">
      <em>Após a Queda</em>
    </p>
  </section>

  <Ornament variant="cross" />

  {
    featured && (
      <section class="featured" aria-label="Ensaio em destaque">
        <p class="featured__kicker">
          <CrossMark size={10} />
          <span>Ensaio {toRoman(featured.data.sequence)}</span>
        </p>

        <article class="featured__inner">
          {featured.data.heroImage && (
            <figure class="featured__figure">
              <img
                src={featured.data.heroImage}
                alt={featured.data.heroImageAlt ?? featured.data.title}
                loading="eager"
              />
            </figure>
          )}

          <div class="featured__body">
            <h2 class="featured__title">
              <a href={`/ensaios/${featured.id}/`}>{featured.data.title}</a>
            </h2>

            <p class="featured__lede">{featured.data.description}</p>

            <p class="featured__meta">
              <time datetime={pubDateToDatetime(featured.data.pubDate)}>{featuredDate}</time>
              <span>·</span>
              <span>{featured.data.readingTime} de leitura</span>
            </p>

            {featured.data.categories.length > 0 && (
              <ul class="tag-list featured__tags">
                {featured.data.categories.slice(0, 3).map((category) => (
                  <li>{category}</li>
                ))}
              </ul>
            )}

            <p class="featured__cta">
              <a href={`/ensaios/${featured.id}/`}>Ler o ensaio →</a>
            </p>
          </div>
        </article>
      </section>
    )
  }

  {
    archive.length > 0 && (
      <>
        <Ornament variant="fleuron" />

        <section aria-label="Arquivo">
          <header class="section-heading">
            <div class="section-heading__rule">
              <span>Arquivo</span>
            </div>
            <h2>Outros ensaios</h2>
          </header>

          <EssayList essays={archive} />
        </section>
      </>
    )
  }
</BaseLayout>
