---
import { getCollection } from "astro:content";
import EssayList from "@components/EssayList.astro";
import Ornament from "@components/Ornament.astro";
import CrossMark from "@components/CrossMark.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const allEssays = (await getCollection("essays", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sequence - b.data.sequence);

const featured = allEssays[0];
const archive = allEssays.slice(1);

const featuredDate = featured
  ? new Intl.DateTimeFormat("pt-BR", {
      day: "2-digit",
      month: "long",
      year: "numeric",
    }).format(featured.data.pubDate)
  : "";

const year = new Date().getFullYear();

const toRoman = (num: number): string => {
  const map: [number, string][] = [
    [1000, "M"], [900, "CM"], [500, "D"], [400, "CD"],
    [100, "C"], [90, "XC"], [50, "L"], [40, "XL"],
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let n = num;
  let result = "";
  for (const [value, symbol] of map) {
    while (n >= value) {
      result += symbol;
      n -= value;
    }
  }
  return result;
};
---

<BaseLayout>
  <section class="masthead" aria-label="Edição corrente">
    <p class="masthead__line">
      Caderno de ensaios · {year}
      <span class="masthead__sep">·</span>
      Edição inaugural
    </p>
    <div class="masthead__rule" aria-hidden="true">
      <span></span>
      <CrossMark size={11} />
      <span></span>
    </div>
  </section>

  <section class="epigraph" aria-label="Epígrafe">
    <p class="epigraph__text">
      O pecado original não é apenas uma teoria doutrinária, mas é uma condição presente
      reconhecível nos desejos, nas escolhas e nas pequenas desordens da vida comum.
    </p>
    <p class="epigraph__cite">
      Hipótese central · <em>Após a Queda</em>
    </p>
  </section>

  <Ornament variant="cross" />

  {
    featured && (
      <section class="featured" aria-label="Ensaio em destaque">
        <p class="featured__kicker">
          <CrossMark size={10} />
          <span>Ensaio {toRoman(featured.data.sequence)}</span>
        </p>

        <article class="featured__inner">
          {featured.data.heroImage && (
            <figure class="featured__figure">
              <img
                src={featured.data.heroImage}
                alt={featured.data.heroImageAlt ?? featured.data.title}
                loading="eager"
              />
            </figure>
          )}

          <div class="featured__body">
            <h2 class="featured__title">
              <a href={`/ensaios/${featured.id}/`}>{featured.data.title}</a>
            </h2>

            <p class="featured__lede">{featured.data.description}</p>

            <p class="featured__meta">
              <time datetime={featured.data.pubDate.toISOString()}>{featuredDate}</time>
              <span>·</span>
              <span>{featured.data.readingTime} de leitura</span>
            </p>

            {featured.data.categories.length > 0 && (
              <ul class="tag-list featured__tags">
                {featured.data.categories.slice(0, 3).map((category) => (
                  <li>{category}</li>
                ))}
              </ul>
            )}

            <p class="featured__cta">
              <a href={`/ensaios/${featured.id}/`}>Ler o ensaio →</a>
            </p>
          </div>
        </article>
      </section>
    )
  }

  {
    archive.length > 0 && (
      <>
        <Ornament variant="fleuron" />

        <section aria-label="Arquivo">
          <header class="section-heading">
            <div class="section-heading__rule">
              <span>Arquivo</span>
            </div>
            <h2>Demais ensaios</h2>
            <p>Para leitura lenta, releitura e investigação continuada.</p>
          </header>

          <EssayList essays={archive} />
        </section>
      </>
    )
  }

  <Ornament />

  <section aria-label="Hipóteses de trabalho">
    <header class="section-heading">
      <div class="section-heading__rule"><span>Hipóteses</span></div>
      <h2>Frases que orientam o arquivo</h2>
      <p>
        Formulações provisórias para pensar a condição humana ferida pelo pecado
        original, antes de falar sobre política, estruturas sociais ou psicologia.
      </p>
    </header>

    <ol class="thesis-grid">
      <li>
        <span class="thesis-grid__number">I</span>
        <p>
          Muitos problemas sociais possuem raízes antropológicas mais profundas
          do que suas manifestações imediatas.
        </p>
      </li>
      <li>
        <span class="thesis-grid__number">II</span>
        <p>
          A inclinação ao mal aparece antes da intenção plenamente formada e
          continua agindo mesmo depois da educação.
        </p>
      </li>
      <li>
        <span class="thesis-grid__number">III</span>
        <p>
          O pecado original não destrói a liberdade; ele a torna vulnerável à
          fuga da verdade, da responsabilidade e do bem.
        </p>
      </li>

      <li>
        <span class="thesis-grid__number">V</span>
        <p>
          Instituições podem amplificar desordens que já habitam a pessoa humana.
        </p>
      </li>
      <li>
        <span class="thesis-grid__number">VI</span>
        <p>
          A graça de Deus não apaga magicamente a condição humana ferida; ela a ilumina,
          sustenta e chama à conversão.
        </p>
      </li>
    </ol>
  </section>

  <Ornament variant="fleuron" />

  <section aria-label="Próximos ensaios">
    <header class="section-heading">
      <div class="section-heading__rule"><span>Caderno de perguntas</span></div>
      <h2>Ensaios em preparação</h2>
      <p>
        Títulos provisórios para uma investigação que deve crescer como arquivo.
      </p>
    </header>

    <ol class="future-list">
      <li>
        <span class="future-list__title">
          A criança, o adulto e a mesma desordem
        </span>
      </li>
      <li>
        <span class="future-list__title">O desejo de ser o centro</span>
      </li>
      <li>
        <span class="future-list__title">
          A estranha persistência do egoísmo
        </span>
      </li>
      <li>
        <span class="future-list__title">Obediência e responsabilidade após o pecado original</span>
      </li>
      <li>
        <span class="future-list__title">
          Como instituições refletem desordens já presentes na pessoa humana?
        </span>
      </li>
    </ol>
  </section>

  <Ornament />

  <section aria-label="Direção intelectual">
    <header class="section-heading">
      <div class="section-heading__rule"><span>Direção intelectual</span></div>
      <h2>O que se investiga aqui</h2>
      <p>
        Como a desordem introduzida pelo pecado original continua se manifestando
        na consciência, nos desejos, nas relações, na cultura e nas instituições.
      </p>
    </header>

    <ul class="topics-grid" aria-label="Temas centrais">
      <li>
        <span class="topics-grid__name">Antropologia do pecado original</span>
        <span class="topics-grid__count">Em ensaio</span>
        <p class="topics-grid__hint">
          A investigação começa pela condição humana, antes de chegar às estruturas.
        </p>
      </li>
      <li>
        <span class="topics-grid__name">Consciência e liberdade</span>
        <span class="topics-grid__count">Em ensaio</span>
        <p class="topics-grid__hint">
          Como a liberdade permanece real e, ao mesmo tempo, inclinada à fuga do bem.
        </p>
      </li>
      <li>
        <span class="topics-grid__name">Desejo e centralidade</span>
        <span class="topics-grid__count">Em ensaio</span>
        <p class="topics-grid__hint">
          O orgulho não deseja apenas prazer ou poder; deseja ocupar o centro.
        </p>
      </li>
    </ul>
  </section>
</BaseLayout>
