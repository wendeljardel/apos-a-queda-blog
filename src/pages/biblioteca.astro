---
import { getCollection } from "astro:content";
import Ornament from "@components/Ornament.astro";
import CrossMark from "@components/CrossMark.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const books = await getCollection("books");
books.sort((a, b) => a.data.author.localeCompare(b.data.author, "pt-BR"));

const fathersAndDoctors = [
  { name: "Santo Agostinho", note: "Antropologia do pecado original, libido dominandi" },
  { name: "G. K. Chesterton", note: "Natureza humana, pecado original, realismo cristão" },
  { name: "Joseph Ratzinger / Bento XVI", note: "Antropologia cristã, liberdade, graça" },
];

const traditionAndModern = [
  { name: "São Tomás de Aquino", note: "Natureza humana, virtudes, vontade e lei natural" },
  { name: "Romano Guardini", note: "Maturidade humana, consciência, responsabilidade" },
  { name: "Henri de Lubac", note: "Natureza e graça, antropologia cristã" },
  { name: "São John Henry Newman", note: "Consciência, assentimento e desenvolvimento doutrinal" },
];

const interlocutors = [
  { name: "Hannah Arendt", note: "Banalidade do mal, consciência, julgamento" },
  { name: "Reinhold Niebuhr", note: "Ironia da história, realismo cristão" },
  { name: "Michel Foucault", note: "Poder, disciplina e descrição de fenômenos institucionais" },
];

const magisterium = [
  {
    title: "Lumen gentium",
    source: "Concílio Vaticano II, 1964",
    note: "Constituição dogmática sobre a Igreja — eclesiologia de comunhão e santidade peregrina.",
  },
  {
    title: "Gaudium et spes",
    source: "Concílio Vaticano II, 1965",
    note: "A Igreja no mundo contemporâneo — dignidade da pessoa e da consciência (§ 16).",
  },
  {
    title: "Dei Verbum",
    source: "Concílio Vaticano II, 1965",
    note: "Sobre a Revelação divina, Escritura e Tradição.",
  },
  {
    title: "Veritatis splendor",
    source: "São João Paulo II, 1993",
    note: "Verdade moral, consciência, lei natural e fundamentos da teologia moral.",
  },
  {
    title: "Catecismo da Igreja Católica",
    source: "1992 / 1997",
    note: "Síntese normativa da fé, da liturgia, da vida em Cristo e da oração.",
  },
];
---

<BaseLayout
  title="Biblioteca"
  description="Referências da Tradição católica e interlocutores para pensar pecado original, antropologia cristã e condição humana."
>
  <header class="page-intro">
    <p class="essay__kicker">
      <CrossMark size={10} />
      <span style="margin-left:0.4rem">Referências</span>
    </p>
    <h1 class="page-intro__title">Biblioteca</h1>
    <p class="page-intro__sub">
      Autores, obras e documentos que sustentam a investigação sobre pecado
      original, condição humana, consciência, liberdade e vida comum.
    </p>
  </header>

  <Ornament variant="cross" />

  <section>
    <header class="section-heading">
      <div class="section-heading__rule"><span>Obras comentadas</span></div>
      <h2>Leituras de base</h2>
    </header>

    {
      books.length === 0 ? (
        <p class="page-intro__sub" style="text-align:center">
          Nenhuma obra comentada ainda.
        </p>
      ) : (
        <ol class="references">
          {books.map((book) => (
            <li>
              <div>
                <p class="references__author">{book.data.author}</p>
                {book.data.categories.length > 0 && (
                  <ul
                    class="tag-list"
                    style="justify-content:flex-start;margin-top:0.5rem"
                  >
                    {book.data.categories.map((category) => (
                      <li>{category}</li>
                    ))}
                  </ul>
                )}
              </div>
              <div>
                <h3 class="references__title">{book.data.title}</h3>
                <p class="references__body">{book.data.description}</p>
              </div>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <Ornament variant="fleuron" />

  <section>
    <header class="section-heading">
      <div class="section-heading__rule"><span>Núcleo principal</span></div>
      <h2>Referências de base</h2>
      <p>A raiz da investigação — pecado original, liberdade, consciência e natureza humana.</p>
    </header>

    <ul class="topics-grid" aria-label="Padres e Doutores da Igreja">
      {
        fathersAndDoctors.map((entry) => (
          <li>
            <span class="topics-grid__name">{entry.name}</span>
            <p class="topics-grid__hint">{entry.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <Ornament />

  <section>
    <header class="section-heading">
      <div class="section-heading__rule"><span>Segundo círculo</span></div>
      <h2>Mestres e interlocutores próximos</h2>
      <p>Vozes que ajudam a pensar natureza, graça, consciência e responsabilidade.</p>
    </header>

    <ul class="topics-grid" aria-label="Mestres modernos">
      {
        traditionAndModern.map((entry) => (
          <li>
            <span class="topics-grid__name">{entry.name}</span>
            <p class="topics-grid__hint">{entry.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <Ornament />

  <section>
    <header class="section-heading">
      <div class="section-heading__rule"><span>Documentos eclesiais</span></div>
      <h2>Magistério de referência</h2>
      <p>Textos conciliares e papais que balizam a leitura.</p>
    </header>

    <ol class="references">
      {
        magisterium.map((doc) => (
          <li>
            <div>
              <p class="references__author">{doc.source}</p>
            </div>
            <div>
              <h3 class="references__title">
                <em>{doc.title}</em>
              </h3>
              <p class="references__body">{doc.note}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <Ornament />

  <section>
    <header class="section-heading">
      <div class="section-heading__rule"><span>Diálogo</span></div>
      <h2>Interlocutores</h2>
      <p>
        Pensadores não católicos relidos a partir do horizonte da fé — em diálogo
        e em tensão fecunda.
      </p>
    </header>

    <ul class="topics-grid" aria-label="Interlocutores">
      {
        interlocutors.map((entry) => (
          <li>
            <span class="topics-grid__name">{entry.name}</span>
            <p class="topics-grid__hint">{entry.note}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
