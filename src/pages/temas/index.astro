---
import { getCollection } from "astro:content";
import Ornament from "@components/Ornament.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const essays = await getCollection("essays", ({ data }) => !data.draft);

const topics = [
  {
    name: "Pecado Original",
    hint: "A ferida de origem como chave para ler desejos, culpa e liberdade.",
  },
  {
    name: "Antropologia Católica",
    hint: "O que o homem é — e o que ficou ferido — segundo a fé da Igreja.",
  },
  {
    name: "Consciência",
    hint: "Onde a verdade ainda fala — e onde se foge dela.",
  },
  {
    name: "Liberdade",
    hint: "Real, mas inclinada; capaz do bem e pronta a se esquivar.",
  },
  {
    name: "Desejo",
    hint: "Do bem ao centro do palco: o que a vontade busca de fato.",
  },
  {
    name: "Formação Moral",
    hint: "Educar sem ingenuidade: a inclinação ao mal e a graça.",
  },
  {
    name: "Natureza Ferida",
    hint: "Não só um passado distante — uma condição que aparece no cotidiano.",
  },
  {
    name: "Autoridade",
    hint: "Quando o serviço vira domínio, e o que isso revela do coração.",
  },
  {
    name: "Abuso Espiritual",
    hint: "Tutela demais, paternalismo e o mal que se disfarça de cuidado.",
  },
  {
    name: "São Francisco",
    hint: "Minoridade como recusa de ocupar o centro.",
  },
  {
    name: "Poder",
    hint: "O poder não inventa a desordem; costuma só ampliá-la.",
  },
  {
    name: "Igreja",
    hint: "Santa e feita de pecadores — e o que isso exige de nós.",
  },
  {
    name: "Relações Humanas",
    hint: "Egoísmo, posse e o outro tratado como meio.",
  },
  {
    name: "Notas de Leitura",
    hint: "Citações, conceitos e apontamentos de caderno.",
  },
];

const allCategories = [
  ...new Set([
    ...topics.map((topic) => topic.name),
    ...essays.flatMap((essay) => essay.data.categories),
  ]),
].sort((a, b) => a.localeCompare(b, "pt-BR"));

const hintFor = (category: string) =>
  topics.find((topic) => topic.name === category)?.hint ??
  "Ainda sem nota própria neste mapa.";

const countFor = (category: string) =>
  essays.filter((essay) => essay.data.categories.includes(category)).length;
---

<BaseLayout
  title="Temas"
  description="Temas que atravessam os ensaios de Após a Queda."
>
  <header class="page-intro">
    <p class="essay__kicker">Mapa de leitura</p>
    <h1 class="page-intro__title">Temas</h1>
    <p class="page-intro__sub">
      Filamentos que voltam nos ensaios: pecado original, consciência, desejo,
      autoridade, formação moral.
    </p>
  </header>

  <Ornament />

  <ul class="topics-grid" aria-label="Lista de temas">
    {
      allCategories.map((category) => {
        const count = countFor(category);
        return (
          <li>
            <span class="topics-grid__name">{category}</span>
            <span class="topics-grid__count">
              {count === 0 ? "—" : `${count} texto${count === 1 ? "" : "s"}`}
            </span>
            <p class="topics-grid__hint" set:html={hintFor(category)} />
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
