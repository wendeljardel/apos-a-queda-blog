---
import { getCollection } from "astro:content";
import Ornament from "@components/Ornament.astro";
import BaseLayout from "@layouts/BaseLayout.astro";

const essays = await getCollection("essays", ({ data }) => !data.draft);

const topics = [
  {
    name: "Pecado Original",
    hint:
      "A ferida original como chave para compreender desejos, consciência, liberdade e vida comum.",
  },
  {
    name: "Antropologia Católica",
    hint:
      "A análise começa pela condição humana antes de chegar às estruturas sociais e políticas.",
  },
  {
    name: "Consciência",
    hint:
      "A consciência pode reconhecer a verdade, mas também fugir dela quando a responsabilidade pesa.",
  },
  {
    name: "Liberdade",
    hint:
      "A liberdade permanece real depois do pecado original, mas ferida, inclinada e necessitada de graça.",
  },
  {
    name: "Desejo",
    hint:
      "O desejo humano pode buscar o bem, mas também centralidade, domínio, posse e isenção de culpa.",
  },
  {
    name: "Formação Moral",
    hint:
      "Educar é reconhecer a inclinação ao mal sem desesperar da graça e da liberdade.",
  },
  {
    name: "Natureza Ferida",
    hint:
      "O pecado original não é apenas passado: é uma condição presente que aparece no cotidiano.",
  },
  {
    name: "Autoridade",
    hint:
      "A autoridade continua importante, mas como uma expressão entre outras da condição humana ferida.",
  },
  {
    name: "Abuso Espiritual",
    hint:
      "O abuso espiritual raramente começa como malícia explícita; muitas vezes nasce de paternalismo e excesso de tutela.",
  },
  {
    name: "São Francisco",
    hint:
      "A minoridade franciscana é uma recusa espiritual da centralidade e da dominação.",
  },
  {
    name: "Poder",
    hint:
      "O poder amplifica desordens que já habitam a pessoa humana.",
  },
  {
    name: "Igreja",
    hint:
      "Mesmo instituições santas permanecem habitadas por seres humanos caídos.",
  },
  {
    name: "Relações Humanas",
    hint:
      "Depois do pecado original, relações humanas podem tender ao egoísmo, à posse e à instrumentalização.",
  },
  {
    name: "Notas de Leitura",
    hint:
      "Conceitos, citações e hipóteses ainda em forma de caderno.",
  },
];

const allCategories = [
  ...new Set([
    ...topics.map((topic) => topic.name),
    ...essays.flatMap((essay) => essay.data.categories),
  ]),
].sort((a, b) => a.localeCompare(b, "pt-BR"));

const hintFor = (category: string) =>
  topics.find((topic) => topic.name === category)?.hint ??
  "Tema em desenvolvimento no arquivo.";

const countFor = (category: string) =>
  essays.filter((essay) => essay.data.categories.includes(category)).length;
---

<BaseLayout
  title="Temas"
  description="Categorias iniciais de investigação do projeto Após a Queda."
>
  <header class="page-intro">
    <p class="essay__kicker">Mapa de leitura</p>
    <h1 class="page-intro__title">Temas</h1>
    <p class="page-intro__sub">
      Os ensaios se organizam ao redor de hipóteses sobre pecado original,
      antropologia católica, consciência, liberdade, desejo, formação moral e vida
      comum depois do pecado original.
    </p>
  </header>

  <Ornament />

  <ul class="topics-grid" aria-label="Lista de temas">
    {
      allCategories.map((category) => {
        const count = countFor(category);
        return (
          <li>
            <span class="topics-grid__name">{category}</span>
            <span class="topics-grid__count">
              {count === 0 ? "Em ensaio" : `${count} texto${count === 1 ? "" : "s"}`}
            </span>
            <p class="topics-grid__hint" set:html={hintFor(category)} />
          </li>
        );
      })
    }
  </ul>
</BaseLayout>
